<?xml version="1.0" encoding="UTF-8"?>
<!-- 附带的 deno 用 Developer ID 签名时（开着 hardened runtime，公证要求）加的授权：V8 要 JIT，没有它 deno 能报版本、跑不了 JS
     （yt-dlp 解 YouTube 的验证靠 deno 跑 JS）。scripts/build-release.sh 签名时用，scripts/check-bundle.sh 第 2 项会真的跑一段 JS 核对。 -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
</dict>
</plist>
