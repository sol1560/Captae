{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Captae",
  "version": "0.2.0",
  "identifier": "app.captae.desktop",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Captae",
        "url": "index.html",
        "width": 1440,
        "height": 900,
        "minWidth": 640,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 38
        },
        "backgroundColor": "#ebebeb",
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https: data:; media-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Video",
    "shortDescription": "Download and organize video and audio on your own computer",
    "copyright": "Captae contributors · AGPL-3.0-or-later",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "gen/infoplist/en.lproj/InfoPlist.strings": "en.lproj/InfoPlist.strings",
      "gen/infoplist/zh-Hans.lproj/InfoPlist.strings": "zh-Hans.lproj/InfoPlist.strings",
      "gen/infoplist/zh-Hant.lproj/InfoPlist.strings": "zh-Hant.lproj/InfoPlist.strings",
      "gen/infoplist/ja.lproj/InfoPlist.strings": "ja.lproj/InfoPlist.strings",
      "gen/infoplist/ko.lproj/InfoPlist.strings": "ko.lproj/InfoPlist.strings",
      "gen/infoplist/es.lproj/InfoPlist.strings": "es.lproj/InfoPlist.strings",
      "gen/infoplist/fr.lproj/InfoPlist.strings": "fr.lproj/InfoPlist.strings",
      "gen/infoplist/de.lproj/InfoPlist.strings": "de.lproj/InfoPlist.strings"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUwN0MyQTlBRUQyNzEwREMKUldUY0VDZnRtaXA4VUNZNi9YU0wzd0ZIdHhycFY0MXRlUVBNeUs2VldFZlVKeUQwL3N0TTAwZSsK",
      "endpoints": [
        "https://github.com/sol1560/Captae/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
