{
  "name": "captae-desktop-ui",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
    "typecheck": "tsc --noEmit -p .",
    "affectui": "node scripts/fetch-affectui.mjs",
    "build:mock": "vite build --mode mock --outDir dist-mock",
    "build:popup": "vite build -c vite.popup.config.ts",
    "build:dmg-bg": "vite build -c vite.dmg.config.ts",
    "dev:site": "npm run build:mock && vite -c vite.site.config.ts",
    "build:site": "npm run build:mock && vite build -c vite.site.config.ts"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "@tauri-apps/api": "~2.12.5",
    "lenis": "1.3.17",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
